# 自动检测文本文件并规范化行结束符
* text=auto eol=lf

# 明确指定文本文件
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf diff=markdown
*.yml text eol=lf
*.yaml text eol=lf

# 图片文件 - 二进制
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary

# SVG 是文本
*.svg text eol=lf

# 3D 模型文件 - 二进制
*.glb binary
*.gltf text eol=lf
*.obj text eol=lf
*.fbx binary
*.hdr binary
*.exr binary

# 字体文件 - 二进制
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
